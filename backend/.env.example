# Copy to backend/.env and fill in. Never commit the real .env.

# SQLite file (created automatically). Use postgresql+psycopg://... if you move to Postgres.
DATABASE_URL=sqlite:///./data/rowlog.db

# Development: the Vite dev server on :5173 proxies /api to this backend.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Strava API application: https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5173/api/strava/callback

# Production (single server on :8000 serving the built frontend):
# FRONTEND_URL=http://localhost:8000
# STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback
# STATIC_DIR=../frontend/dist
